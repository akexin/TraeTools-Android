<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TraeTools.App"
             xmlns:local="using:TraeTools">
    <!-- 不写死 RequestedThemeVariant：默认值即「跟随系统」，
         实际取值由 App.ApplyThemeMode(AppConfig.ThemeMode) 在视图创建前按用户配置覆盖。 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TraeTools/Styles/AppTheme.axaml" />
    </Application.Styles>
</Application>
