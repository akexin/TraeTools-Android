<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 双目标：Windows 桌面（win-x64 单文件）+ Android 手机版（apk）。
         2026-10 起同时维护桌面端与移动端，Windows 专属能力（WinForms/WebView2/DPAPI/托盘）
         均按 TargetFramework 条件编译，Android 端用平台实现替代（见 Platform/ 目录）。
         注意：Avalonia 12 系列最低支持 .NET 10（Avalonia.Android 12.1.2 仅提供 net10.0-android36.0），
         故两端统一使用 .NET 10（LTS）。 -->
    <TargetFrameworks>net10.0-windows;net10.0-android</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>TraeTools</AssemblyTitle>
    <Product>TraeTools</Product>
    <!-- 以下 Version/InformationalVersion 由 ReadVersionFromJson 目标在生成 AssemblyInfo 前从 version.json 自动读取并覆盖。
         发版时只需修改 version.json，csproj 无需手工同步。 -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <NoWarn>CA1416;MSB3277;XA0121;CS0436</NoWarn>
  </PropertyGroup>

  <!-- ============ Windows 专属 ============ -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <!-- 发布瘦身：单文件 + 原生库内嵌自解压 + Brotli 压缩，减小 exe 体积（仅影响发布，不影响普通编译） -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- ============ Android 专属 ============ -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>cn.akexin.traetools</ApplicationId>
    <ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
    <ApplicationVersion>10</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- 注意：ApplicationManifest/ApplicationIcon/UseWindowsForms 仅 Windows 条件组定义，
         本 TFM 下不赋值即不生效，无需清空；单文件发布属性同理（Android 不支持 PublishSingleFile） -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" Condition="'$(TargetFramework)' == 'net9.0-windows'" />
    <Using Remove="System.Drawing" Condition="'$(TargetFramework)' == 'net9.0-windows'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
    <!-- Android 资源（图标/主题/启动画面），仅 Android 目标参与生成 -->
    <AndroidResource Include="Resources\**" Condition="'$(TargetFramework)' == 'net9.0-android'" />
  </ItemGroup>

  <!-- Windows-only 源文件（WinForms + WebView2 登录宿主，Android 无对应实现） -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
    <Compile Remove="Services\Login\LoginHostForm.cs" />
    <Compile Remove="Services\Login\WebViewLoginHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- version.json 内嵌为程序集资源：保证单文件分发/发布时 exe 自带真实版本，无需外置文件同步 -->
    <EmbeddedResource Include="version.json" />
    <!-- 同时复制到输出目录（非单文件或调试时也可见），供无内嵌机制的旧流程回退 -->
    <None Include="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 从 version.json 自动同步 Version/InformationalVersion（生成 AssemblyInfo 前执行） -->
  <Target Name="ReadVersionFromJson" BeforeTargets="GenerateAssemblyInfo;GenerateAssemblyInfoInternal">
    <PropertyGroup>
      <_VJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\version.json'))</_VJsonContent>
      <_VJsonVer>$([System.Text.RegularExpressions.Regex]::Match('$(_VJsonContent)', '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</_VJsonVer>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_VJsonVer)' != ''">
      <Version>$(_VJsonVer)</Version>
      <InformationalVersion>$(_VJsonVer)</InformationalVersion>
      <ApplicationDisplayVersion Condition="'$(TargetFramework)' == 'net9.0-android'">$(_VJsonVer)</ApplicationDisplayVersion>
    </PropertyGroup>
    <Message Text="Version read from version.json: $(_VJsonVer) (applied to Version/InformationalVersion)" Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" Condition="'$(TargetFramework)' == 'net9.0-windows'" />
    <PackageReference Include="Avalonia.Android" Version="12.1.2" Condition="'$(TargetFramework)' == 'net9.0-android'" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <!-- Android 端 SQLite 原生库（e_sqlite3 的 android arm/arm64/x64/x86 变体；
         Windows 端由 bundle_e_sqlite3 自带，不会重复引入。版本跟随 Microsoft.Data.Sqlite 的 SQLitePCLRaw 传递依赖 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.*" Condition="'$(TargetFramework)' == 'net9.0-android'" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" Condition="'$(TargetFramework)' == 'net9.0-windows'" />
  </ItemGroup>
</Project>
