<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 双目标：Windows 桌面（win-x64 单文件）+ Android 手机版（apk）。
         2026-10 起同时维护桌面端与移动端，Windows 专属能力（WinForms/WebView2/DPAPI/托盘）
         均按 TargetFramework 条件编译，Android 端用平台实现替代（见 Platform/ 目录）。
         注意：Avalonia 12 系列最低支持 .NET 10（Avalonia.Android 12.1.2 仅提供 net10.0-android36.0），
         故两端统一使用 .NET 10（LTS）。 -->
    <TargetFrameworks>net10.0-windows;net10.0-android</TargetFrameworks>
    <!-- 多目标项目在非 Windows 系统上还原/构建时，net10.0-windows 也需要 Windows 目标包，
         开启后可从 NuGet 下载（CI 的 ubuntu job 同样依赖此项，Windows 本机上为无操作） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>TraeTools</AssemblyTitle>
    <Product>TraeTools</Product>
    <NoWarn>CA1416;MSB3277;XA0121;CS0436</NoWarn>
  </PropertyGroup>

  <!-- ============ 版本号单一真源 = version.json ============
       必须在「求值期」（普通 PropertyGroup，非 Target 内）读取：
       Target 内的赋值只对求值之后运行的 Target 可见，而 .NET for Android 生成
       AndroidManifest（versionName）发生在很靠前的阶段，用 Target 赋值会导致
       清单里仍是 csproj 的静态兜底值，与 version.json 脱节。
       下面的兜底值仅在 version.json 缺失/异常时生效，正常发版不会用到。 -->
  <PropertyGroup>
    <_VJsonRaw Condition="Exists('$(MSBuildProjectDirectory)\version.json')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\version.json'))</_VJsonRaw>
    <_VJsonVer>$([System.Text.RegularExpressions.Regex]::Match('$(_VJsonRaw)', '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</_VJsonVer>
    <Version Condition="'$(_VJsonVer)' != ''">$(_VJsonVer)</Version>
    <Version Condition="'$(_VJsonVer)' == ''">1.0.0</Version>
    <InformationalVersion Condition="'$(_VJsonVer)' != ''">$(_VJsonVer)</InformationalVersion>
    <InformationalVersion Condition="'$(_VJsonVer)' == ''">1.0.0</InformationalVersion>
    <!-- 发版时只需改 version.json；此处仅作提示，便于在 CI 日志里确认版本源已生效 -->
    <_VersionSourceMessage>Version = $(_VJsonVer)</_VersionSourceMessage>
  </PropertyGroup>

  <!-- ============ Windows 专属 ============ -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <!-- RuntimeIdentifier 必须写在这里（按 TFM 条件），不能由命令行 -r 传入：
         命令行 -r 是全局属性，会渗入 android TFM 的还原，去找不存在的
         Microsoft.NETCore.App.Runtime.Mono.win-x64 而报 NU1102（多目标项目 + 单目标发布） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 发布瘦身：单文件 + 原生库内嵌自解压 + Brotli 压缩，减小 exe 体积（仅影响发布，不影响普通编译） -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- ============ Android 专属 ============ -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>cn.akexin.traetools</ApplicationId>
    <!-- android:versionName —— 必须与 version.json 同源，否则「设置-应用信息」与 App 内「关于」会互相矛盾。
         取自上面的求值期变量 _VJsonVer；缺失时才用兜底值。 -->
    <ApplicationDisplayVersion Condition="'$(_VJsonVer)' != ''">$(_VJsonVer)</ApplicationDisplayVersion>
    <ApplicationDisplayVersion Condition="'$(_VJsonVer)' == ''">1.0.0</ApplicationDisplayVersion>
    <!-- android:versionCode —— 必须严格单调递增，否则无法覆盖安装。由 bump-version 工作流自增。 -->
    <ApplicationVersion>16</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- 关闭 AOT 与链接器：.NET for Android 在 Release 下默认对程序集做 LLVM AOT，
         反射路径（ViewLocator 的 Activator.CreateInstance、SQLitePCLRaw provider 初始化、
         System.Text.Json / CommunityToolkit 源生成之外的反射）在 AOT 下可能抛
         MissingRuntimeArtifactException，表现为"启动即闪退"。
         本应用是网络 IO 型工具，AOT 收益有限，稳定性优先，故显式关闭。 -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AOTAssemblies>false</AOTAssemblies>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 注意：ApplicationManifest/ApplicationIcon/UseWindowsForms 仅 Windows 条件组定义，
         本 TFM 下不赋值即不生效，无需清空；单文件发布属性同理（Android 不支持 PublishSingleFile） -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <Using Remove="System.Drawing" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
    <!-- Android 资源（图标/主题/启动画面），仅 Android 目标参与生成 -->
    <AndroidResource Include="Resources\**" Condition="'$(TargetFramework)' == 'net10.0-android'" />
  </ItemGroup>

  <!-- Windows-only 源文件（WinForms + WebView2 登录宿主，Android 无对应实现） -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <Compile Remove="Services\Login\LoginHostForm.cs" />
    <Compile Remove="Services\Login\WebViewLoginHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- version.json 内嵌为程序集资源：保证单文件分发/发布时 exe 自带真实版本，无需外置文件同步 -->
    <EmbeddedResource Include="version.json" />
    <!-- 同时复制到输出目录（非单文件或调试时也可见），供无内嵌机制的旧流程回退 -->
    <None Include="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 版本号同步已在文件顶部「版本号单一真源」PropertyGroup 中于求值期完成，
       此处不再需要 BeforeTargets 目标：Target 内的赋值对 .NET for Android 的
       AndroidManifest 生成阶段不可见，曾导致 APK 的 versionName 与 version.json 脱节。 -->
  <Target Name="ReportVersionSource" BeforeTargets="BeforeBuild">
    <Message Text="Version read from version.json: $(_VJsonVer) (applied at evaluation time to Version/InformationalVersion/ApplicationDisplayVersion)" Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <PackageReference Include="Avalonia.Android" Version="12.1.2" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <!-- Android 端 SQLite 原生库（e_sqlite3 的 android arm/arm64/x64/x86 变体；
         Windows 端由 bundle_e_sqlite3 自带，不会重复引入。版本跟随 Microsoft.Data.Sqlite 的 SQLitePCLRaw 传递依赖 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.*" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>
</Project>
