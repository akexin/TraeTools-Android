<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Android 13（API 33）起发送通知需声明并运行时申请此权限；
       运行时申请见 Platform/MainActivity.cs 的 MainActivity.Current 与
       Services/Notify/SystemNotifier.cs 的 RequestPermission()。
       走清单而非 [assembly: UsesPermission] 特性：与本文件既有的 INTERNET 声明保持一致，
       且不依赖绑定库中特性构造函数的签名。 -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 11（API 30）起有「包可见性」限制。startActivity 走隐式 Intent 本身不受限，
       但个别定制 ROM 会拦截，且未来需要用 resolveActivity 做兜底判断时必须能看见浏览器。
       因此显式声明 http/https 的 VIEW 查询意图，让本应用始终能解析到系统浏览器。
       对应代码：Platform/BrowserLauncher.cs（授权 GitHub 等按钮自动打开浏览器）。 -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="http" />
    </intent>
  </queries>
  <application android:label="TraeTools"
               android:icon="@mipmap/ic_launcher"
               android:roundIcon="@mipmap/ic_launcher_round"
               android:theme="@style/MyTheme.NoActionBar"
               android:supportsRtl="true" />
</manifest>
