<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.CheckinView"
             x:DataType="vm:CheckinViewModel">

    <Design.DataContext>
        <vm:CheckinViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- ===== 日历格：圆形格子 + 状态样式（已签/漏签/今日/未签） ===== -->
        <Style Selector="Border.day">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.day TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <!-- 已签：品牌色实心圆 + 轻投影浮起 -->
        <Style Selector="Border.day-checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BoxShadow" Value="0 3 8 0 #33335CFF" />
        </Style>
        <Style Selector="Border.day-checked TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- 漏签：低饱和红淡底（比实心红更轻） -->
        <Style Selector="Border.day-missed">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        </Style>
        <Style Selector="Border.day-missed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <!-- 今日：描边圆环高亮 -->
        <Style Selector="Border.day-today">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.day-today TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.day-blank TextBlock">
            <Setter Property="Foreground" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="每日签到" Classes="page-title" />
                    <TextBlock Text="{Binding PageSubtitle}" Classes="page-subtitle" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="btn-hero" Content="{Binding CheckinButtonText}" Command="{Binding DoCheckinCommand}"
                            IsEnabled="{Binding !CheckedInToday}" />
                </StackPanel>
            </Grid>

            <!-- ===== 签到账号勾选（手动一键与自动签到共用同一勾选） ===== -->
            <Border Grid.Row="1" Classes="card" Padding="16,12" Margin="0,16,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="选择签到账号（自动签到与此一致）" Classes="text-caption" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding CheckAccounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" Margin="0,1,16,1" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Hero Card：品牌渐变 + 连签进度环 ===== -->
            <Border Grid.Row="2" CornerRadius="16" Padding="22,18" Margin="0,16,0,0"
                    Background="{DynamicResource BrandHeroBrush}" BoxShadow="0 6 20 0 #2E2D5BFF">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="今日奖励" Foreground="#C7D2FE" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding TodayReward}" Foreground="White" FontSize="30" FontWeight="ExtraBold" />
                        <TextBlock Text="积分" Foreground="#C7D2FE" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>
                    <!-- 会员徽章 + 签到结果/今日已签 状态，合并到同一行居中展示 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding HasStatusMessage}">
                        <Border Background="#22FFFFFF" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding MemberHint}" Foreground="#CBD5E1" FontSize="11" />
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#C7D2FE"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                    <!-- Streak Progress Ring：圆环减小，与紧凑布局匹配 -->
                    <Canvas Grid.Column="1" Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Canvas.Left="12" Canvas.Top="12" Width="72" Height="72" Stroke="#33FFFFFF" StrokeThickness="7" />
                        <Path Data="M 48,12 A 36,36 0 1 1 13.1,45.6" Stroke="White" StrokeThickness="7" StrokeLineCap="Round" />
                        <StackPanel Canvas.Left="12" Canvas.Top="34" Width="72">
                            <TextBlock Text="{Binding StreakDays}" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="连续天数" Foreground="#C7D2FE" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Canvas>
                </Grid>
            </Border>

            <!-- ===== Calendar + Records（占满剩余高度，内部各自滚动） ===== -->
            <UniformGrid Grid.Row="3" Classes="stack2" Margin="0,16,0,0" Rows="1" Columns="2">
                <!-- Calendar -->
                <Border Grid.Column="0" Classes="card stack-first" Margin="0,0,12,0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="本月签到日历" Classes="card-title" />
                            <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" Classes="text-caption" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="日" Classes="text-caption" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="一" Classes="text-caption" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="二" Classes="text-caption" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="三" Classes="text-caption" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="四" Classes="text-caption" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="五" Classes="text-caption" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="六" Classes="text-caption" HorizontalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="38" Height="38" Margin="3,3" CornerRadius="19"
                                            Classes="day"
                                            Classes.day-checked="{Binding IsChecked}"
                                            Classes.day-missed="{Binding IsMissed}"
                                            Classes.day-today="{Binding IsToday}"
                                            Classes.day-blank="{Binding IsBlank}"
                                            ToolTip.Tip="{Binding ToolTipText}"
                                            ToolTip.ShowDelay="250"
                                            ToolTip.Placement="Bottom">
                                        <TextBlock Text="{Binding DisplayDay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="13" Height="13" CornerRadius="7" Background="{DynamicResource AccentBrush}" />
                                <TextBlock Text="已签" Classes="text-caption" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="13" Height="13" CornerRadius="7" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" />
                                <TextBlock Text="今日" Classes="text-caption" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="13" Height="13" CornerRadius="7" Background="{DynamicResource DangerSoftBrush}" />
                                <TextBlock Text="漏签" Classes="text-caption" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="13" Height="13" CornerRadius="7" Background="Transparent" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" />
                                <TextBlock Text="未签" Classes="text-caption" />
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Records -->
                <Border Grid.Column="1" Classes="card stack-second" Margin="12,0,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="签到记录" Classes="card-title" />
                        <!-- 空状态：简约插画提示 -->
                        <StackPanel Grid.Row="1" IsVisible="{Binding HasNoRecords}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <PathIcon Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                                          Data="M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19z M12 4.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15z M10.7 13.6 8.4 11.3 7 12.7l3.7 3.7 6.3-6.3-1.4-1.4z" />
                            </Border>
                            <TextBlock Text="暂无签到记录" Classes="empty-title" />
                            <TextBlock Text="完成签到后，这里会展示最近的签到结果" Classes="empty-desc" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding !HasNoRecords}">
                        <ItemsControl ItemsSource="{Binding Records}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,9,0,9" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="12,0">
                                                <TextBlock Text="{Binding Date}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Account}" Classes="text-caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Result}" FontSize="13" FontWeight="Bold" Foreground="{Binding ResultBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </UniformGrid>
        </Grid>
</UserControl>
