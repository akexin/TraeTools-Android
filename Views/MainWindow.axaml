<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TraeTools.ViewModels"
        xmlns:views="using:TraeTools.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="TraeTools.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="TraeTools"
        Background="{StaticResource ContentBgBrush}"
        FontFamily="Inter,Microsoft YaHei UI,Segoe UI">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- 实际界面全部在 MainView（UserControl）中：
         Android 是单视图平台，不能创建 Window，直接把 MainView 作为 MainView 生命周期的根视图；
         Windows 端则由本窗口包一层，承载托盘/最小化等桌面专属行为。 -->
    <views:MainView />
</Window>
