<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="760"
             x:Class="TraeTools.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource ContentBgBrush}"
             FontFamily="Inter,Microsoft YaHei UI,Segoe UI">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- ===== 顶栏图标按钮：线性图标 + 悬停淡底（替代原底部 Tab 实心图标） ===== -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
        </Style>

        <!-- ===== 顶栏状态徽章：可点击展开云端详情 ===== -->
        <Style Selector="Button.status-chip">
            <Setter Property="Background" Value="{DynamicResource RowBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.status-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
        </Style>

        <!-- ===== 顶栏状态圆点：默认灰 / 运行中绿 / 待部署黄 ===== -->
        <Style Selector="Ellipse.sdot">
            <Setter Property="Fill" Value="{DynamicResource TextSubBrush}" />
        </Style>
        <Style Selector="Ellipse.sdot.sdot-ok">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.sdot.sdot-warn">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>
        <!-- 云端运行中的微弱呼吸灯：增加"活着"的科技感 -->
        <Style Selector="Ellipse.pulse">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ===== 顶栏与内容区边距：由样式给出（局部属性会压过样式，故不写在元素上） ===== -->
        <Style Selector="Border.topbar">
            <Setter Property="Padding" Value="20,12,16,12" />
        </Style>
        <Style Selector="Border.content-host">
            <Setter Property="Padding" Value="20,20" />
        </Style>

        <!-- ===== 紧凑模式（手机 <640px）：边距收紧 ===== -->
        <Style Selector="Grid.compact Border.content-host">
            <Setter Property="Padding" Value="12,14" />
        </Style>
        <Style Selector="Grid.compact Border.topbar">
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </UserControl.Styles>

    <!-- compact 类由代码按实际宽度切换，控制上方 Grid.compact 样式 -->
    <Grid x:Name="RootGrid" Classes.compact="{Binding IsCompact}" RowDefinitions="Auto,*">

        <!-- ============ 顶栏：小号加粗标题 + 云端状态徽章 + 设置入口 ============ -->
        <Border Grid.Row="0" Classes="topbar"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="签到助手" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center" />
                        <!-- 云端状态徽章：点击展开/收起详情 -->
                        <Button Classes="status-chip" VerticalAlignment="Center"
                                Command="{Binding Home.ToggleCloudDetailCommand}"
                                ToolTip.Tip="点击查看云端详情" ToolTip.ShowDelay="250">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" Classes="sdot"
                                         Classes.sdot-ok="{Binding Home.IsCloudRunning}"
                                         Classes.sdot-warn="{Binding Home.IsCloudWarning}"
                                         Classes.pulse="{Binding Home.IsCloudRunning}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Home.CloudBadgeText}" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="icon-btn" IsVisible="{Binding !IsSettingsActive}"
                                Command="{Binding NavigateCommand}" CommandParameter="settings"
                                ToolTip.Tip="设置" ToolTip.ShowDelay="250">
                            <PathIcon Width="16" Height="16"
                                      Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.49.49 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                        </Button>
                        <Button Classes="icon-btn" IsVisible="{Binding IsSettingsActive}"
                                Command="{Binding NavigateCommand}" CommandParameter="home"
                                ToolTip.Tip="返回签到" ToolTip.ShowDelay="250">
                            <PathIcon Width="16" Height="16"
                                      Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== 云端详情：由状态徽章展开（默认收起，避免信息过载） ===== -->
                <Border IsVisible="{Binding Home.ShowCloudDetail}"
                        Background="{DynamicResource RowBgBrush}" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="云端状态" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSubBrush}" />
                        <TextBlock Text="{Binding Home.Cloud.StateText}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="上次运行" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="{Binding Home.Cloud.LastRun}" FontSize="11"
                                       Foreground="{DynamicResource TextMainBrush}" />
                        </StackPanel>
                        <TextBlock Text="云端每日北京时间 08:00 自动签到" FontSize="11"
                                   Foreground="{DynamicResource TextSubBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============ 内容区（默认单页：本地签到 + 云端托管 + 最近记录） ============ -->
        <Border Grid.Row="1" Classes="content-host"
                Background="{DynamicResource ContentBgBrush}">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>

        <!-- ============ Overlay 对话框宿主（必须跨满整个 Grid） ============ -->
        <!-- Android 单视图平台无法创建 Window（WindowingPlatformStub.CreateWindow 直接抛
             NotSupportedException），所有对话框都以 UserControl 形式借用此覆盖层呈现；桌面端不使用。
             ⚠️ 必须显式 RowSpan，否则覆盖层只占一行，对话框会被挤到顶栏位置 -->
        <Panel x:Name="OverlayRoot" Grid.Row="0" Grid.RowSpan="2"
               IsVisible="False" ZIndex="999">
            <Border Background="#88000000" />
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Margin="20,0" MaxWidth="620"
                    Background="{DynamicResource CardBgBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                    ClipToBounds="True">
                <ScrollViewer MaxHeight="620">
                    <ContentPresenter x:Name="OverlayContent" Margin="4" />
                </ScrollViewer>
            </Border>
        </Panel>
    </Grid>
</UserControl>
