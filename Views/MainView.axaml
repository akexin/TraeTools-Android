<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="TraeTools.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource ContentBgBrush}"
             FontFamily="Inter,Microsoft YaHei UI,Segoe UI">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- ===== 底部标签栏（紧凑模式） ===== -->
        <Style Selector="Button.tab-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Foreground" Value="#8CA0B8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tab-item /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.tab-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tab-item:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Button.tab-item.tab-active">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.tab-item.tab-active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ===== 紧凑模式覆盖样式（仅 IsCompact=true 时生效，作用于整个页面子树） ===== -->
        <!-- 内容区边距收紧 -->
        <Style Selector="^.compact Border.content-host">
            <Setter Property="Padding" Value="14,12,14,16" />
        </Style>
        <!-- 仪表盘：页头按钮换行堆叠 -->
        <Style Selector="^.compact Grid.dash-header">
            <Setter Property="ColumnDefinitions" Value="*" />
            <Setter Property="RowDefinitions" Value="Auto,Auto" />
        </Style>
        <Style Selector="^.compact StackPanel.dash-actions">
            <Setter Property="(Grid.Row)" Value="1" />
            <Setter Property="(Grid.Column)" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <!-- 仪表盘：趋势图 / 账号概览 由双列改上下堆叠 -->
        <Style Selector="^.compact Grid.dash-lower">
            <Setter Property="ColumnDefinitions" Value="*" />
            <Setter Property="RowDefinitions" Value="Auto,Auto" />
        </Style>
        <Style Selector="^.compact Border.chart-card">
            <Setter Property="(Grid.Row)" Value="0" />
            <Setter Property="(Grid.Column)" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^.compact Border.overview-card">
            <Setter Property="(Grid.Row)" Value="1" />
            <Setter Property="(Grid.Column)" Value="0" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <!-- 签到 / 设置 / 用量页：双列卡片上下堆叠 -->
        <Style Selector="^.compact Grid.stack2">
            <Setter Property="ColumnDefinitions" Value="*" />
            <Setter Property="RowDefinitions" Value="Auto,Auto" />
        </Style>
        <Style Selector="^.compact Border.stack-first">
            <Setter Property="(Grid.Row)" Value="0" />
            <Setter Property="(Grid.Column)" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^.compact Border.stack-second">
            <Setter Property="(Grid.Row)" Value="1" />
            <Setter Property="(Grid.Column)" Value="0" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <!-- 用量页：4 张汇总卡 2x2 排布 -->
        <Style Selector="^.compact Grid.stat-grid">
            <Setter Property="ColumnDefinitions" Value="*,*" />
            <Setter Property="RowDefinitions" Value="Auto,Auto" />
        </Style>
        <Style Selector="^.compact Border.stat0">
            <Setter Property="(Grid.Row)" Value="0" />
            <Setter Property="(Grid.Column)" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="^.compact Border.stat1">
            <Setter Property="(Grid.Row)" Value="0" />
            <Setter Property="(Grid.Column)" Value="1" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="^.compact Border.stat2">
            <Setter Property="(Grid.Row)" Value="1" />
            <Setter Property="(Grid.Column)" Value="0" />
            <Setter Property="Margin" Value="0,10,6,0" />
        </Style>
        <Style Selector="^.compact Border.stat3">
            <Setter Property="(Grid.Row)" Value="1" />
            <Setter Property="(Grid.Column)" Value="1" />
            <Setter Property="Margin" Value="6,10,0,0" />
        </Style>
    </UserControl.Styles>

    <!-- compact 类由代码按实际宽度切换，控制上方所有 ^.compact 样式 -->
    <Grid x:Name="RootGrid" Classes.compact="{Binding IsCompact}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar（桌面 / 宽屏） ============ -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                Background="{StaticResource SidebarBgBrush}"
                IsVisible="{Binding !IsCompact}">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Brand area -->
                <StackPanel Grid.Row="0" Margin="20,26,20,18">
                    <TextBlock Text="TraeTools" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="签到 · 账号切换 · 用量统计" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Nav items -->
                <StackPanel Grid.Row="1" Margin="12,8" Spacing="4">
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding IsDashboardActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" />
                            <TextBlock Text="仪表盘" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding IsUsageActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="usage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Σ" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" />
                            <TextBlock Text="用量统计" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding IsCheckinActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="checkin">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" />
                            <TextBlock Text="每日签到" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 账号切换：仅 Windows 桌面端可用（Android 无本地 Trae 客户端可操作） -->
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding IsSwitchActive}"
                            IsVisible="{Binding IsSwitchSupported}"
                            Command="{Binding NavigateCommand}" CommandParameter="switch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" />
                            <TextBlock Text="账号切换" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding IsCloudActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="cloud">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☁" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" />
                            <TextBlock Text="云端签到" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding IsSettingsActive}"
                            Command="{Binding NavigateCommand}" CommandParameter="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Version footer：动态展示版本，与"关于/更新检查"同源，避免写死导致错位 -->
                <TextBlock Grid.Row="2" Text="{Binding AppVersion}"
                           Foreground="#64748B" FontSize="11"
                           Margin="20,12" />
            </Grid>
        </Border>

        <!-- ============ Mobile 顶栏（紧凑模式） ============ -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{StaticResource SidebarBgBrush}"
                Padding="16,12,16,10"
                IsVisible="{Binding IsCompact}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="TraeTools" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="签到 · 用量 · 账号" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ Content Area ============ -->
        <Border Grid.Row="1" Grid.Column="1" Classes="content-host"
                Background="{StaticResource ContentBgBrush}" Padding="28,32">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>

        <!-- ============ Mobile 底部标签栏（紧凑模式） ============ -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{StaticResource SidebarBgBrush}"
                Padding="6,6,6,8"
                IsVisible="{Binding IsCompact}">
            <Grid ColumnDefinitions="*,*,*,*,*,*">
                <Button Grid.Column="0" Classes="tab-item" Classes.tab-active="{Binding IsDashboardActive}"
                        Command="{Binding NavigateCommand}" CommandParameter="dashboard">
                    <StackPanel Spacing="2">
                        <TextBlock Text="▦" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="仪表盘" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="tab-item" Classes.tab-active="{Binding IsUsageActive}"
                        Command="{Binding NavigateCommand}" CommandParameter="usage">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Σ" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="用量" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="tab-item" Classes.tab-active="{Binding IsCheckinActive}"
                        Command="{Binding NavigateCommand}" CommandParameter="checkin">
                    <StackPanel Spacing="2">
                        <TextBlock Text="✓" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="签到" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="tab-item" Classes.tab-active="{Binding IsSwitchActive}"
                        IsVisible="{Binding IsSwitchSupported}"
                        Command="{Binding NavigateCommand}" CommandParameter="switch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="⇄" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="切换" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Classes="tab-item" Classes.tab-active="{Binding IsCloudActive}"
                        Command="{Binding NavigateCommand}" CommandParameter="cloud">
                    <StackPanel Spacing="2">
                        <TextBlock Text="☁" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="云端" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Classes="tab-item" Classes.tab-active="{Binding IsSettingsActive}"
                        Command="{Binding NavigateCommand}" CommandParameter="settings">
                    <StackPanel Spacing="2">
                        <TextBlock Text="⚙" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="设置" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============ Overlay 对话框宿主（必须跨满整个 Grid） ============ -->
        <!-- Android 单视图平台无法创建 Window（WindowingPlatformStub.CreateWindow 直接抛
             NotSupportedException），所有对话框都以 UserControl 形式借用此覆盖层呈现；桌面端不使用。
             ⚠️ 必须显式 RowSpan/ColumnSpan，否则覆盖层只占一个单元格，对话框会被挤到侧栏位置 -->
        <Panel x:Name="OverlayRoot" Grid.Row="0" Grid.Column="0"
               Grid.RowSpan="3" Grid.ColumnSpan="2"
               IsVisible="False" ZIndex="999">
            <Border Background="#88000000" />
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Margin="20,0" MaxWidth="620"
                    Background="White" CornerRadius="12"
                    BorderBrush="#FF334155" BorderThickness="1"
                    ClipToBounds="True">
                <ScrollViewer MaxHeight="620">
                    <ContentPresenter x:Name="OverlayContent" Margin="4" />
                </ScrollViewer>
            </Border>
        </Panel>
    </Grid>
</UserControl>
