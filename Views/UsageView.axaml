<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:models="using:TraeTools.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.UsageView"
             x:DataType="vm:UsageViewModel">

    <Design.DataContext>
        <vm:UsageViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 会话/模型行卡片：去边框淡底圆角行，减少与外层卡片的双线感 -->
        <Style Selector="Border.usage-card">
            <Setter Property="Background" Value="{DynamicResource RowBgBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="用量统计" Classes="page-title" />
                    <TextBlock Text="{Binding CurrentAccount}" Classes="page-subtitle" />
                    <TextBlock Text="{Binding DataRangeText}" Classes="text-caption" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Classes="text-caption" VerticalAlignment="Center" />
                    <Button Classes="btn-primary" Content="拉取用量" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding !IsLoading}" />
                </StackPanel>
            </Grid>

            <!-- ===== 汇总卡片 ===== -->
            <UniformGrid Grid.Row="1" Classes="stat-grid" Margin="0,16,0,0" Rows="1" Columns="4">
                <Border Grid.Column="0" Classes="card stat0" Margin="0,0,12,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="记录会话" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TotalSessions}" Classes="card-value" />
                            <TextBlock Text="次" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card stat1" Margin="12,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="积分消耗" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TotalCreditsText}" Classes="card-value" Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="分" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card stat2" Margin="12,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Token（入/出）" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TotalTokensText}" Classes="card-value" FontSize="24" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="tokens" FontSize="11" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalTokensDetail}" Classes="text-caption"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="card stat3" Margin="12,0,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="缓存命中" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding CacheHitText}" Classes="card-value" Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding CacheHitRate, StringFormat={}{0:0}%}" Classes="card-value" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== 积分快过期提醒 ===== -->
            <Border Grid.Row="2" Classes="card" IsVisible="{Binding HasExpiring}" Margin="0,16,0,0" Padding="20,16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="积分快过期提醒" Classes="card-title" />
                        <TextBlock Grid.Column="1" Text="{Binding ExpiringTotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExpiringItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ExpiringEntItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                    <Border Grid.Column="0" Classes="badge-warn">
                                        <TextBlock Text="{Binding CreditsText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountdownText}" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 会话列表 + 模型分布（占满剩余高度，内部各自滚动） ===== -->
            <UniformGrid Grid.Row="3" Classes="stack2" Margin="0,16,0,0" Rows="1" Columns="2">
                <!-- 会话列表 -->
                <Border Grid.Column="0" Classes="card stack-first" Margin="0,0,12,0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="逐会话用量" Classes="card-title" />
                            <TextBlock Grid.Column="1" Text="最多展示 500 条，汇总按全部" Classes="text-caption" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" Background="Transparent"
                                 Focusable="False" Margin="0,8,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,3" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:UsageSessionRecord">
                                    <Border Classes="usage-card">
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="80,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Classes="text-caption" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ModelText}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding CreditsFloat, StringFormat={}{0:#.#}分}" FontSize="13"
                                                           FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0"
                                                           Classes="text-caption"
                                                           Text="{Binding TokenBrief}" />
                                            </Grid>
                                            <TextBlock Text="{Binding UserInputPreview}" Classes="text-caption"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="460">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{Binding UserInputPreview}" FontSize="12" MaxWidth="420" TextWrapping="Wrap" />
                                                </ToolTip.Tip>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 模型分布 -->
                <Border Grid.Column="1" Classes="card stack-second" Margin="12,0,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="模型分布" Classes="card-title" />
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ModelStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ModelUsageStat">
                                            <Border Classes="usage-card" Margin="0,0,0,8">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SessionCount, StringFormat={}{0} 次}" Classes="text-caption" />
                                                    </Grid>
                                                    <TextBlock Classes="text-caption" Text="{Binding TokenBrief}" />
                                                    <TextBlock Classes="text-caption" Text="{Binding DetailText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </UniformGrid>
        </Grid>
</UserControl>
