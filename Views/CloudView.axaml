<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.CloudView"
             x:DataType="vm:CloudViewModel">

    <Design.DataContext>
        <vm:CloudViewModel />
    </Design.DataContext>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">

            <!-- ===== Header ===== -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="云端签到" Classes="page-title" />
                    <TextBlock Text="GitHub Actions 自动签到 · 永不掉线" Classes="page-subtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="btn-primary" Content="{Binding ActionButtonText}" Command="{Binding OneClickDeployCommand}" />
            </Grid>

            <!-- ===== 授权状态区 ===== -->
            <Border Classes="card" Margin="0,4,0,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="GitHub 授权" Classes="card-title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="btn" Content="粘贴 Token(PAT)" Command="{Binding UsePatCommand}"
                                Padding="12,6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding StateText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DeviceCodeText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== 部署流程：纵向步骤列表（编号圆点 + 状态色，替代死板的横排 1-2-3） ===== -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="部署流程" Classes="card-title" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="一键部署自动完成 · 仅状态展示" Classes="text-caption" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="30,*" Margin="0,5">
                                    <!-- 编号节点：当前/已完成状态由 VM 着色 -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                            Background="{Binding StatusBgBrush}" BorderBrush="{Binding StatusFgBrush}" BorderThickness="1"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Index}" FontSize="13" FontWeight="Bold" Foreground="{Binding StatusFgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusFgBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="点上方主按钮「一键部署到云端」即自动完成全部步骤；本区只反映当前进度。" Classes="text-caption" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== Deploy Status：键值对列表 ===== -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="部署状态" Classes="card-title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="btn-ghost" Content="打开 Actions" Command="{Binding OpenActionsCommand}" />
                    </Grid>
                    <!-- KV 行：灰色小标签 + 主值 -->
                    <Grid ColumnDefinitions="110,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="GitHub 用户" Classes="text-caption" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding GitHubUser}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnDefinitions="110,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="Fork 仓库" Classes="text-caption" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ForkRepo}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnDefinitions="110,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="cron 表达式" Classes="text-caption" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CronExpression}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnDefinitions="110,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="凭证有效期" Classes="text-caption" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CredentialExpiry}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnDefinitions="110,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="上次运行" Classes="text-caption" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding LastRun}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- 凭证有效期提示：细长信息条（弱化底色，突出文字） -->
                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚠" FontSize="13" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WarningText}" FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Deploy Log（底部部署操作日志，固定可观高度，内部自带滚动） ===== -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="部署日志" Classes="card-title" />
                        <TextBlock Grid.Column="1" Text="操作明细" Classes="text-caption" />
                    </Grid>
                    <Border Classes="code-box" MinHeight="140" MaxHeight="260">
                        <ScrollViewer>
                            <TextBlock Text="{Binding DeployLog}" Foreground="{DynamicResource CodeTextBrush}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
