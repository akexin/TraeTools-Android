<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 设置行之间的细分隔线 -->
        <Style Selector="Border.row-sep">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderBrushKey}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>
        <!-- 账号管理卡片：当前激活账号高亮粗边框（与仪表盘一致） -->
        <Style Selector="Border.acct-card.acct-active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">

        <!-- ===== Scrollable Content ===== -->
        <ScrollViewer Grid.Row="0" Background="Transparent" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- ===== Header ===== -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="设置" Classes="page-title" />
                        <TextBlock Text="外观 · 自动化 · Token · 推送 · 账号" Classes="page-subtitle" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="btn-primary" Content="保存设置" Command="{Binding SaveSettingsCommand}" />
                </Grid>

                <!-- ===== 通用与自动签到：垂直列表流（替代左右双列，修复窄屏遮挡/拥挤） ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">

                        <!-- 主题模式：跟随系统 / 浅色 / 深色（切换立即生效并自动保存） -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="主题模式" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="跟随系统可随系统深色模式自动切换配色" Classes="text-caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeModeIndex}" MinWidth="118"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                        </Grid>

                        <Border Classes="row-sep" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="每日自动签到" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="到达指定时间自动执行" Classes="text-caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckinEnabled}" OnContent="" OffContent="" />
                        </Grid>

                        <!-- 签到时间：标签在上、输入在下（垂直结构，避免错位） -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="签到时间" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Text="{Binding AutoCheckinTime}" MaxWidth="160" HorizontalAlignment="Left"
                                     PlaceholderText="HH:mm" />
                            <TextBlock Text="建议非高峰时段" Classes="text-caption" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="签到间隔（秒）" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Text="{Binding CheckinIntervalSeconds}" MaxWidth="160" HorizontalAlignment="Left" />
                            <TextBlock Text="多账号签到间隔，防止触发风控" Classes="text-caption" />
                        </StackPanel>

                        <!-- 开机自启 / 托盘（仅 Windows 桌面端） -->
                        <StackPanel IsVisible="{Binding IsWindowsDesktopOnlyFeaturesSupported}" Spacing="12">
                            <Border Classes="row-sep" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock Text="开机自启" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="系统启动时自动运行" Classes="text-caption" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartEnabled}" OnContent="" OffContent="" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock Text="最小化到托盘" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="关闭窗口时驻留托盘" Classes="text-caption" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" OnContent="" OffContent="" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Token 信息 ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Token 信息" Classes="card-title" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="btn-ghost" Content="复制" Command="{Binding CopyTokenCommand}" />
                        </Grid>
                        <!-- 凭证展示：浅灰文本区（替代生硬深色块） -->
                        <Border Classes="code-box" MinHeight="72">
                            <TextBlock Text="{Binding TokenString}" Foreground="{DynamicResource CodeTextBrush}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="更新时间：" Classes="text-caption" />
                            <TextBlock Text="{Binding TokenUpdateTime}" FontSize="11" Foreground="{DynamicResource TextMainBrush}" FontFamily="Consolas" />
                        </StackPanel>
                        <!-- 设备号独占一行（修复窄屏与按钮重叠），操作按钮独立成行右对齐 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="设备号" Classes="text-caption" />
                            <TextBlock Text="{Binding DeviceIdText}" FontSize="12" Foreground="{DynamicResource TextMainBrush}"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="btn" Content="一键换全部" Padding="12,6" FontSize="12"
                                    Command="{Binding RenewAllDeviceIdsCommand}" />
                            <Button Classes="btn" Content="更换" Padding="12,6" FontSize="12"
                                    Command="{Binding RegenerateDeviceIdCommand}" />
                        </StackPanel>
                        <!-- 9074 风控说明：默认折叠，降低页面杂乱感 -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <Expander.Header>
                                <TextBlock Text="设备号被风控标记（9074）怎么办？" Classes="text-caption" />
                            </Expander.Header>
                            <TextBlock Text="更换设备号即可解除「参与用户太多（9074）」风控标记；云端签到需重新「云端部署」同步新的设备号。"
                                       Classes="text-caption" TextWrapping="Wrap" Margin="0,4,0,8" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ===== 推送通知 ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="推送通知" Classes="card-title" />
                                <TextBlock Text="签到完成后推送到已启用的渠道；各渠道相互独立，任一失败不影响其它" Classes="text-caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyOnCheckin}" OnContent="" OffContent=""
                                          VerticalAlignment="Center" ToolTip.Tip="总开关" />
                        </Grid>

                        <!-- ===== 飞书 ===== -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Text="飞书机器人" FontSize="13" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,4,0,8">
                                <TextBlock Text="Webhook 地址" Classes="text-caption" />
                                <TextBox Text="{Binding FeishuWebhook}" Padding="8,6" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                         PlaceholderText="https://open.feishu.cn/open-apis/bot/v2/hook/…" />
                                <TextBlock Text="在飞书群中添加「自定义机器人」后复制其 Webhook 地址填入。" Classes="text-caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Border Classes="row-sep" Margin="0,0" />

                        <!-- ===== 邮箱 SMTP ===== -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="邮箱推送（自定义 SMTP）" FontSize="13" FontWeight="SemiBold" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EmailEnabled}" OnContent="" OffContent="" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,4,0,8">
                                <Grid ColumnDefinitions="*,110">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                        <TextBlock Text="SMTP 服务器" Classes="text-caption" />
                                        <TextBox Text="{Binding SmtpHost}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                                 PlaceholderText="smtp.qq.com" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="端口" Classes="text-caption" />
                                        <TextBox Text="{Binding SmtpPort}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="连接加密方式" Classes="text-caption" />
                                    <ComboBox SelectedIndex="{Binding SmtpSecurityIndex}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="SSL / TLS（隐式，465）" />
                                        <ComboBoxItem Content="STARTTLS（587）" />
                                        <ComboBoxItem Content="不加密（25）" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="用户名（通常是邮箱地址）" Classes="text-caption" />
                                    <TextBox Text="{Binding SmtpUser}" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="密码 / 授权码" Classes="text-caption" />
                                    <TextBox Text="{Binding SmtpPassword}" PasswordChar="●" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                                    <TextBlock Text="多数邮箱服务商需使用「SMTP 授权码」而非登录密码，请到邮箱设置中开启 SMTP 服务并获取授权码。"
                                               Classes="text-caption" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                        <TextBlock Text="发件人（留空用用户名）" Classes="text-caption" />
                                        <TextBox Text="{Binding SmtpFrom}" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="收件人（多个用逗号分隔）" Classes="text-caption" />
                                        <TextBox Text="{Binding SmtpTo}" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <Button Classes="btn" Content="发送测试邮件" Command="{Binding TestEmailCommand}"
                                        HorizontalAlignment="Left" Padding="12,6" FontSize="12" />
                            </StackPanel>
                        </Expander>

                        <Border Classes="row-sep" Margin="0,0" />

                        <!-- ===== 通用 Webhook ===== -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="通用 Webhook" FontSize="13" FontWeight="SemiBold" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding WebhookEnabled}" OnContent="" OffContent="" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,4,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="目标地址" Classes="text-caption" />
                                    <TextBox Text="{Binding WebhookUrl}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                             PlaceholderText="https://…" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="请求体模板（{title} 与 {content} 为占位符）" Classes="text-caption" />
                                    <TextBox Text="{Binding WebhookBodyTemplate}" AcceptsReturn="True" Height="64"
                                             TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Content-Type" Classes="text-caption" />
                                    <TextBox Text="{Binding WebhookContentType}" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                                </StackPanel>
                                <TextBlock Text="示例：Server 酱填 {&quot;title&quot;:&quot;{title}&quot;,&quot;desp&quot;:&quot;{content}&quot;}；Bark 填 {&quot;title&quot;:&quot;{title}&quot;,&quot;body&quot;:&quot;{content}&quot;}。"
                                           Classes="text-caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Border Classes="row-sep" Margin="0,0" />

                        <!-- ===== 钉钉 ===== -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="钉钉群机器人" FontSize="13" FontWeight="SemiBold" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding DingTalkEnabled}" OnContent="" OffContent="" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,4,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Webhook 地址" Classes="text-caption" />
                                    <TextBox Text="{Binding DingTalkWebhook}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                             PlaceholderText="https://oapi.dingtalk.com/robot/send?access_token=…" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="加签密钥（可选；机器人安全设置选「加签」时填写）" Classes="text-caption" />
                                    <TextBox Text="{Binding DingTalkSecret}" PasswordChar="●" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Border Classes="row-sep" Margin="0,0" />

                        <!-- ===== 企业微信 ===== -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="企业微信群机器人" FontSize="13" FontWeight="SemiBold" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding WeComEnabled}" OnContent="" OffContent="" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,4,0,8">
                                <TextBlock Text="Webhook 地址" Classes="text-caption" />
                                <TextBox Text="{Binding WeComWebhook}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                         PlaceholderText="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=…" />
                            </StackPanel>
                        </Expander>

                        <Border Classes="row-sep" Margin="0,0" />

                        <!-- ===== Telegram ===== -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Telegram Bot" FontSize="13" FontWeight="SemiBold" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding TelegramEnabled}" OnContent="" OffContent="" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,4,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Bot Token" Classes="text-caption" />
                                    <TextBox Text="{Binding TelegramBotToken}" PasswordChar="●" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Chat ID" Classes="text-caption" />
                                    <TextBox Text="{Binding TelegramChatId}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                             PlaceholderText="私聊为数字 ID，群为负数" />
                                </StackPanel>
                                <TextBlock Text="注意：api.telegram.org 在国内网络通常无法直连，需要自备代理，否则会提示请求失败。"
                                           Classes="text-caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Border Classes="row-sep" Margin="0,0" />

                        <!-- ===== 系统本地通知 ===== -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="系统本地通知" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Windows 通知中心 / Android 通知栏；仅在软件运行时有效" Classes="text-caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifySystemEnabled}" OnContent="" OffContent="" />
                        </Grid>

                        <Button Classes="btn" Content="测试全部已启用渠道" Command="{Binding TestNotifyAllCommand}"
                                HorizontalAlignment="Left" Padding="14,6" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- ===== 账号管理 ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Grid.Column="0" Text="账号管理" Classes="card-title" />
                                <TextBlock Text="点击账号即切换为当前账号（首页与签到随之切换）" Classes="text-caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="btn" Content="删除选中" Command="{Binding DeleteAccountCommand}" Padding="12,5"
                                        IsVisible="{Binding !HasNoAccounts}" />
                                <Button Classes="btn-primary" Content="+ 添加" Command="{Binding AddAccountCommand}" Padding="12,5" />
                            </StackPanel>
                        </Grid>
                        <!-- 空状态：未添加账号时的引导 -->
                        <StackPanel IsVisible="{Binding HasNoAccounts}" Spacing="8" Margin="0,8,0,4"
                                    HorizontalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <PathIcon Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                                          Data="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zM12 14c-4.42 0-8 2.24-8 5v1.5h16V19c0-2.76-3.58-5-8-5z" />
                            </Border>
                            <TextBlock Text="还没有添加账号" Classes="empty-title" />
                            <TextBlock Text="添加 Trae 账号后即可自动签到、切换与统计用量" Classes="empty-desc" />
                            <Button Classes="btn-primary" Content="去添加账号" Command="{Binding AddAccountCommand}"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- ListBox：点击账号 → Token 面板联动展示该账号凭证 -->
                        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="240"
                                 IsVisible="{Binding !HasNoAccounts}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem /template/ ContentPresenter" x:SetterTargetType="ContentPresenter">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter" x:SetterTargetType="ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter" x:SetterTargetType="ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SelectedTintBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                                <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter" x:SetterTargetType="ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SelectedTintBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Classes="acct-card"
                                            Classes.acct-active="{Binding IsCurrent}"
                                            Background="{DynamicResource RowBgBrush}" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                                            Padding="12,9" Margin="2,4" HorizontalAlignment="Stretch">
                                        <Grid ColumnDefinitions="32,*,Auto">
                                            <Grid Grid.Column="0" Width="32" Height="32">
                                                <Border CornerRadius="16" Background="{Binding AvatarBrush}" IsVisible="{Binding !HasAvatar}">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Rectangle RadiusX="16" RadiusY="16" IsVisible="{Binding HasAvatar}">
                                                    <Rectangle.Fill>
                                                        <ImageBrush Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="1" Margin="10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding MobileText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" />
                                                    <Border Classes="badge-ok" Padding="6,0" CornerRadius="4" VerticalAlignment="Center" IsVisible="{Binding IsStudent}">
                                                        <TextBlock Text="学生" FontSize="9" Foreground="{DynamicResource SuccessBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="{DynamicResource TextSubBrush}" FontFamily="Consolas" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="999" Padding="10,3" VerticalAlignment="Center"
                                                    Background="{Binding StatusBgBrush}" BorderBrush="{Binding StatusFgBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusFgBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- ===== 账号备份（导出 / 导入） ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="账号备份" Classes="card-title" />
                            <TextBlock Text="导出为口令加密的备份文件，可在另一台设备导入，解决手机与电脑账号不互通的问题"
                                       Classes="text-caption" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="备份口令（至少 6 位，导出与导入需一致）" Classes="text-caption" />
                            <TextBox Text="{Binding BackupPassphrase}" PasswordChar="●" MaxWidth="320"
                                     HorizontalAlignment="Left" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                            <TextBlock Text="口令仅用于本次加解密，不会写入配置；口令遗失将无法恢复备份内容。"
                                       Classes="text-caption" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="btn-primary" Content="导出备份" Command="{Binding ExportAccountsCommand}"
                                    Padding="14,6" FontSize="12" IsEnabled="{Binding !BackupBusy}" />
                            <Button Classes="btn" Content="选择备份文件" Command="{Binding PickBackupFileCommand}"
                                    Padding="14,6" FontSize="12" IsEnabled="{Binding !BackupBusy}" />
                            <Button Classes="btn" Content="导入账号" Command="{Binding ImportAccountsCommand}"
                                    Padding="14,6" FontSize="12" IsEnabled="{Binding !BackupBusy}" />
                        </StackPanel>

                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Text="备份内容（导出结果 / 手动粘贴导入）" Classes="text-caption" />
                            </Expander.Header>
                            <TextBox Text="{Binding BackupText}" AcceptsReturn="True" Height="120"
                                     TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="10.5"
                                     Margin="0,4,0,8"
                                     PlaceholderText="导出后内容会出现在这里；也可把别处得到的备份内容粘贴到这里再点「导入账号」" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ===== About Section ===== -->
                <StackPanel Spacing="12">
                    <TextBlock Text="关于 TraeTools" Classes="page-title" FontSize="18" />

                    <!-- App info card -->
                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="T" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="TraeTools" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="{Binding AppVersion}" Classes="text-caption" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="btn" Content="重置协议" Command="{Binding ResetAgreementCommand}" />
                                <Button Classes="btn" Content="重置软件" Command="{Binding ResetSoftwareCommand}"
                                        Foreground="{DynamicResource DangerBrush}" />
                                <Button Classes="btn" Content="检查更新" Command="{Binding CheckUpdateCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Link rows -->
                    <Border Classes="card">
                        <StackPanel Spacing="4">

                            <!-- 项目仓库（2.0.1 起合并了原先重复的「原仓库 / 我的 Fork 仓库」两行：
                                 两者此前指向同一地址，显示重复且用词误导） -->
                            <Grid ColumnDefinitions="40,*,Auto" Margin="0,6">
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="项目仓库" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="{Binding RepoUrl}" Classes="text-caption" FontFamily="Consolas" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn-ghost" Content="打开 →" Command="{Binding OpenRepoCommand}"
                                        Foreground="{DynamicResource AccentBrush}" Padding="12,6" />
                            </Grid>

                            <Border Classes="row-sep" Margin="0,2" />

                            <!-- 问题反馈 -->
                            <Grid ColumnDefinitions="40,*,Auto" Margin="0,6">
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="问题反馈" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="GitHub Issues" Classes="text-caption" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn-ghost" Content="打开 →" Command="{Binding OpenIssuesCommand}"
                                        Foreground="{DynamicResource AccentBrush}" Padding="12,6" />
                            </Grid>

                            <Border Classes="row-sep" Margin="0,2" />

                            <!-- 为源仓库点 star -->
                            <Grid ColumnDefinitions="40,*,Auto" Margin="0,6">
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="⭐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="为源仓库点 star" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="支持作者 · 已授权可一键点赞" Classes="text-caption" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn-ghost" Content="点赞 →" Command="{Binding StarSourceRepoCommand}"
                                        Foreground="{DynamicResource AccentBrush}" Padding="12,6" />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Bottom Status Bar（全局交互返回，有消息时显示、自动消失） ===== -->
        <Border Grid.Row="1" Background="{DynamicResource StatusWarnBgBrush}" BorderBrush="{DynamicResource StatusWarnBorderBrush}" BorderThickness="1,0,0,0"
                IsVisible="{Binding ShowStatusBar}">
            <Grid ColumnDefinitions="Auto,*" Margin="24,10">
                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="5" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PushStatus}" FontSize="12" Foreground="{DynamicResource StatusWarnFgBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
