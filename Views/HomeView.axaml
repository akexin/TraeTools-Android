<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="760"
             x:Class="TraeTools.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="{DynamicResource ContentBgBrush}"
             FontFamily="Inter,Microsoft YaHei UI,Segoe UI">

    <!-- 注：HomeViewModel 依赖注入式构造（复用共享引擎实例），无无参构造，
         故此处不设 Design.DataContext（仅影响预览器示例数据，运行时绑定不受影响）。 -->

    <UserControl.Styles>
        <!-- ===== 卡片：无边框 + 16px 圆角 + 极微弱投影（0 4 12 rgba(0,0,0,0.03)） ===== -->
        <Style Selector="Border.card-min">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #08000000" />
        </Style>

        <!-- ===== 主色胶囊按钮：一键签到 / 一键授权部署 ===== -->
        <Style Selector="Button.btn-pill">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="24,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-pill:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.btn-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.btn-pill:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDeepBrush}" />
        </Style>
        <!-- 已签到 / 进行中：按钮退为浅灰，避免与主 CTA 抢视觉 -->
        <Style Selector="Button.btn-pill:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderBrushKey}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSubBrush}" />
        </Style>

        <!-- ===== 次要文字链接：打开 Actions / 粘贴 PAT ===== -->
        <Style Selector="Button.link-sub">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link-sub:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- ===== 状态徽章（胶囊） ===== -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource RowBgBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.chip-ok">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        </Style>
        <Style Selector="Border.chip-warn">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        </Style>
        <Style Selector="Border.chip-ok TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.chip-warn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <!-- ===== 状态圆点：默认灰 → 运行中绿（带呼吸灯）→ 待部署黄 ===== -->
        <Style Selector="Ellipse.cdot">
            <Setter Property="Fill" Value="{DynamicResource TextSubBrush}" />
        </Style>
        <Style Selector="Ellipse.cdot.cdot-ok">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.cdot.cdot-warn">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Ellipse.pulse">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel MaxWidth="620" Spacing="16" HorizontalAlignment="Stretch">

            <!-- ================= 模块一：手动本地签到 ================= -->
            <Border Classes="card-min">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="本地签到" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMainBrush}" />
                            <TextBlock Text="立即执行今日签到任务" FontSize="12"
                                       Foreground="{DynamicResource TextSubBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="btn-pill"
                                Content="{Binding Local.CheckinButtonText}"
                                Command="{Binding Local.DoCheckinCommand}"
                                IsEnabled="{Binding Local.CanCheckin}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- 多账号时才出现的极简账号勾选行 -->
                    <StackPanel Spacing="6" IsVisible="{Binding ShowAccountPicker}">
                        <TextBlock Text="签到账号" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                        <ItemsControl ItemsSource="{Binding Local.CheckAccounts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                              FontSize="12" Margin="0,0,16,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 进行中：细加载条 -->
                    <ProgressBar Classes="loading-bar" IsIndeterminate="True" Margin="0"
                                 IsVisible="{Binding Local.IsCheckingIn}" />

                    <!-- 结果反馈 -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding Local.HasStatusMessage}">
                        <TextBlock Text="✅" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Local.StatusMessage}" FontSize="12"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= 模块二：云端部署签到 ================= -->
            <Border Classes="card-min">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="云端自动签到" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="chip"
                                Classes.chip-ok="{Binding IsCloudRunning}"
                                Classes.chip-warn="{Binding IsCloudWarning}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" Classes="cdot"
                                         Classes.cdot-ok="{Binding IsCloudRunning}"
                                         Classes.cdot-warn="{Binding IsCloudWarning}"
                                         Classes.pulse="{Binding IsCloudRunning}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CloudBadgeText}" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 未授权引导：把 GitHub Actions 的复杂感压成一句话 -->
                    <TextBlock IsVisible="{Binding !IsCloudAuthorized}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="授权 GitHub 后，云端将每天自动为您签到，永不掉线。" />

                    <!-- 已授权：竖向流程清单（不再用平铺 1-2-3） -->
                    <ItemsControl ItemsSource="{Binding Cloud.Steps}" IsVisible="{Binding IsCloudAuthorized}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="24,*" Margin="0,4">
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                            Background="{Binding StatusBgBrush}"
                                            BorderBrush="{Binding StatusFgBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding StatusFgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMainBrush}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{Binding StatusFgBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Cloud.StateText}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSubBrush}" />

                    <!-- 宽大主色 CTA：未授权=一键授权 / 已授权=一键部署 -->
                    <Button Classes="btn-pill" HorizontalAlignment="Stretch"
                            Content="{Binding Cloud.ActionButtonText}"
                            Command="{Binding Cloud.OneClickDeployCommand}"
                            IsEnabled="{Binding !IsCloudBusy}" />

                    <ProgressBar Classes="loading-bar" IsIndeterminate="True" Margin="0"
                                 IsVisible="{Binding IsCloudBusy}" />

                    <!-- 次要操作：弱化到文字链接，避免喧宾夺主 -->
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Button Classes="link-sub" Content="打开 Actions 面板"
                                Command="{Binding Cloud.OpenActionsCommand}" />
                        <Button Classes="link-sub" Content="粘贴 Token(PAT)"
                                Command="{Binding Cloud.UsePatCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= 模块三：极简运行日志（最近 3 条，无卡片包裹） ================= -->
            <StackPanel Spacing="2" Margin="4,4,4,20">
                <TextBlock Text="最近记录" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSubBrush}" Margin="4,0,0,6" />
                <TextBlock Text="暂无记录，点上方按钮开始签到" FontSize="12"
                           Foreground="{DynamicResource TextSubBrush}" Margin="4,8,0,8"
                           IsVisible="{Binding HasNoRecentLogs}" />
                <ItemsControl ItemsSource="{Binding RecentLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,10" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource BorderBrushKey}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Date}" FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource TextSubBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Account}" FontSize="12"
                                               Margin="12,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Result}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding ResultBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
